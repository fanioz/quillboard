{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quillboard",
  "version": "0.1.0",
  "identifier": "com.fanioz.quillboard",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Quillboard",
        "width": 800,
        "height": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Organize and manage your AI prompts",
    "longDescription": "Quillboard is a sleek desktop app for organizing AI prompts with Kanban boards, quick search, tags, and advanced LLM options like temperature, top-k, and max tokens.",
    "category": "Productivity",
    "copyright": "© 2024 Fanioz",
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    }
  }
}